{
  "button": {
    "typical": {
      "toggle": {
        "bg-default": {
          "$type": "color",
          "$value": "{mode.color.generic.bg.faint}"
        },
        "border-default": {
          "$type": "color",
          "$value": "{mode.color.none}"
        }
      }
    }
  },
  "container": {
    "modal": {
      "border-default": {
        "$type": "color",
        "$value": "{mode.color.none}"
      }
    },
    "standard": {
      "border-default": {
        "$type": "color",
        "$value": "{mode.color.generic.fg.faint}"
      }
    }
  },
  "nav": {
    "primary": {
      "bg-active": {
        "$type": "color",
        "$value": "{mode.color.generic.bg.delicate}"
      },
      "bg-default": {
        "$type": "color",
        "$value": "{mode.color.generic.surface.trace}"
      },
      "bg-child": {
        "$type": "color",
        "$value": "{mode.color.generic.surface.trace}"
      },
      "bg-childAlt": {
        "$type": "color",
        "$value": "{mode.color.generic.surface.trace}"
      },
      "bg-hover": {
        "$type": "color",
        "$value": "{mode.color.generic.bg.faint}"
      },
      "bg-selected": {
        "$type": "color",
        "$value": "{mode.color.generic.bg.inverse.nought}",
        "$description": "selected keyline under item"
      },
      "border-default": {
        "$type": "color",
        "$value": "{mode.color.none}",
        "$description": "parent container border "
      },
      "divider": {
        "$type": "color",
        "$value": "{mode.color.generic.fg.soft}",
        "$description": "divider within child menus"
      },
      "label-active": {
        "$type": "color",
        "$value": "{mode.color.action.nav.withDefault}"
      },
      "label-default": {
        "$type": "color",
        "$value": "{mode.color.action.nav.withDefault}"
      },
      "label-defaultAlt": {
        "$type": "color",
        "$value": "{mode.color.generic.txt.moderate}"
      },
      "label-hover": {
        "$type": "color",
        "$value": "{mode.color.action.nav.withDefault}"
      }
    }
  },
  "logo": {
    "sage": {
      "inverse": {
        "bg-default": {
          "$type": "color",
          "$value": "{mode.color.brand.default}",
          "$description": "sage logo"
        }
      }
    }
  },
  "tab": {
    "border-activeAlt": {
      "$type": "color",
      "$value": "{mode.color.none}"
    },
    "border-activeOutline": {
      "$type": "color",
      "$value": "{mode.color.generic.surface.nought}"
    },
    "border-default": {
      "$type": "color",
      "$value": "{mode.color.generic.fg.faint}"
    },
    "bg-active": {
      "$type": "color",
      "$value": "{mode.color.none}"
    }
  }
}