{
  "button": {
    "typical": {
      "toggle": {
        "bg-default": {
          "$type": "color",
          "$value": "{mode.color.generic.bg.faint}"
        },
        "border-default": {
          "$type": "color",
          "$value": "{mode.color.none}"
        }
      }
    }
  },
  "nav": {
    "primary": {
      "bg-active": {
        "$type": "color",
        "$value": "{mode.color.generic.bg.delicate}"
      },
      "bg-default": {
        "$type": "color",
        "$value": "{mode.color.generic.bg.nought}"
      },
      "bg-hover": {
        "$type": "color",
        "$value": "{mode.color.generic.bg.delicate}"
      },
      "bg-child": {
        "$type": "color",
        "$value": "{mode.color.generic.bg.nought}"
      },
      "bg-childAlt": {
        "$type": "color",
        "$value": "{mode.color.generic.bg.delicate}"
      },
      "bg-selected": {
        "$type": "color",
        "$value": "{mode.color.generic.bg.inverse.nought}",
        "$description": "selected keyline under item"
      },
      "border-default": {
        "$type": "color",
        "$value": "{mode.color.none}",
        "$description": "parent container border "
      },
      "divider": {
        "$type": "color",
        "$value": "{mode.color.generic.fg.soft}",
        "$description": "divider within child menus"
      },
      "label-active": {
        "$type": "color",
        "$value": "{mode.color.action.nav.withDefault}"
      },
      "label-default": {
        "$type": "color",
        "$value": "{mode.color.action.nav.withDefault}"
      },
      "label-defaultAlt": {
        "$type": "color",
        "$value": "{mode.color.generic.txt.moderate}"
      },
      "label-hover": {
        "$type": "color",
        "$value": "{mode.color.action.nav.withDefault}"
      }
    }
  }
}